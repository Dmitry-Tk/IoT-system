{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: build debug",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the CMake Debug preset."
        }
    ],
    "version": "2.0.0"
}